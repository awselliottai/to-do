{
  "name": "to-do",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts tests/*/*.test.ts",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run test",
    "generate": "drizzle-kit generate --config=drizzle.config.ts",
    "migrate": "drizzle-kit migrate --config=drizzle.config.ts",
    "pull": "drizzle-kit pull --config=drizzle.config.ts",
    "studio": "drizzle-kit studio --config=drizzle.config.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.2",
    "@t3-oss/env-nextjs": "^0.12.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.41.0",
    "drizzle-zod": "^0.7.1",
    "nanoid": "^5.1.5",
    "next": "16.3.3",
    "pg": "^8.16.3",
    "postgres": "^3.4.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/pg": "^8.15.6",
    "drizzle-kit": "^0.30.6",
    "eslint": "^9",
    "eslint-config-next": "16.3.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.28.1"
}